# SPDX-License-Identifier: CC-BY-SA-4.0
game: X-Men vs. Street Fighter (Japan) (3M)
gameid: T-1226G
system: saturn
---

# Per-character health, 144 max, 0 is KO, updated live as damage lands.
watch p1_c1 word 0x060F5040
watch p1_c2 word 0x060F5042
watch p2_c1 word 0x060F5044
watch p2_c2 word 0x060F5046

# 2 from the moment the characters can move until the match is fully
# over, win screens included. 0 in menus and loading.
watch match_state byte 0x060F5400
def in_match match_state == 2

# Humans-in-match bitmask. bit 0 is player 1, bit 1 is player 2
watch p1_playing byte 0x060F5101 mask 0x01
watch p2_playing byte 0x060F5101 mask 0x02
def p1_human p1_playing == 1
def p2_human p2_playing == 2

# Round lost: the last remaining character KOs.
on (p1_c1 decreased to 0 and p1_c2 == 0) or (p1_c2 decreased to 0 and p1_c1 == 0) while in_match and p1_human:
    pattern (1.0 250ms, off 30ms, 1.0 250ms, off 40ms, 1.0 700ms) priority 1
on (p2_c1 decreased to 0 and p2_c2 == 0) or (p2_c2 decreased to 0 and p2_c1 == 0) while in_match and p2_human:
    pattern (1.0 250ms, off 30ms, 1.0 250ms, off 40ms, 1.0 700ms) priority 1 player 2

# Character KO with a partner still alive.
on p1_c1 decreased to 0 or p1_c2 decreased to 0 while in_match and p1_human:
    pattern (0.9 200ms, off 50ms, 1.0 300ms) priority 1 
on p2_c1 decreased to 0 or p2_c2 decreased to 0 while in_match and p2_human:
    pattern (0.9 200ms, off 50ms, 1.0 300ms) priority 1 player 2

# Running total of Hyper Combo damage that side has dealt.
watch p1_hyper_dealt word 0x060F433A
watch p2_hyper_dealt word 0x060F473A

# Taking a Hyper Combo.
on p2_hyper_dealt increased while in_match and p1_human:
    pattern (1.0 120ms, off 40ms, 0.85 120ms, off 40ms, 0.7 200ms)
on p1_hyper_dealt increased while in_match and p2_human:
    pattern (1.0 120ms, off 40ms, 0.85 120ms, off 40ms, 0.7 200ms) player 2
